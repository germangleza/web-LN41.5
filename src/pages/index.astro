---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import RouteCard from '../components/RouteCard.astro';
import ClosingCta from '../components/ClosingCta.astro';
import SectionCta from '../components/SectionCta.astro';
import { designTripUrl } from '../config/site.config';

const todas = await getCollection('rutas', ({ data }) => !data.draft);
const rutas = todas.filter((r) => r.data.kind === 'ruta').sort((a, b) => a.data.order - b.data.order);
// Edición especial que se anuncia en el banner (la primera publicada)
const especial = todas.find((r) => r.data.kind === 'especial');

const servicios = [
  {
    title: 'Curaduría',
    items: ['Menos opciones, mejores decisiones', 'Qué sí vale la pena', 'Qué dejar fuera', 'Cómo combinar regiones y experiencias'],
  },
  {
    title: 'Diseño de viaje',
    items: ['Ruta personalizada', 'Ritmo y lógica del recorrido', 'Selección de experiencias', 'Hospedaje y estructura general'],
  },
  {
    title: 'Acompañamiento',
    items: ['Conversación inicial', 'Concepto de viaje', 'Propuesta', 'Coordinación y seguimiento'],
  },
];

const pasos = [
  { title: 'Conversación inicial', text: 'Entendemos quién viaja, qué buscan, qué fechas tienen y cómo quieren vivir el recorrido.' },
  { title: 'Concepto de viaje', text: 'Construimos una lógica de ruta: regiones, ritmo, experiencias y enfoque general.' },
  { title: 'Propuesta', text: 'Aterrizamos el viaje en una propuesta con estructura, opciones y costos.' },
  { title: 'Coordinación', text: 'Te acompañamos para convertir la idea en un viaje listo para vivir.' },
];

const paraTi = [
  'Ya conociste España y quieres volver.',
  'Quieres salirte del itinerario típico.',
  'Valoras gastronomía, historia, cultura y regiones.',
  'Prefieres criterio en vez de mil recomendaciones.',
  'Quieres un viaje más personal y menos genérico.',
];
---
<BaseLayout fullBleed>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" data-parallax="0.25">
      <Photo name="hero" alt="" eager />
    </div>
    <div class="hero__content">
      <h1 id="hero-title" class="display hero__title" data-split>
        <span>España</span>
        <span>desde</span>
        <span>dentro.</span>
      </h1>
      <div class="hero__aside" data-reveal style="--d: 700">
        <p class="hero__text">
          Diseñamos viajes a España para quienes quieren descubrir regiones, sabores e historias que normalmente se quedan fuera del itinerario tradicional.
        </p>
        <div class="btn-row">
          <a class="btn btn--solid" href={designTripUrl()}>Diseñar mi viaje</a>
          <a class="btn btn--outline" href="#rutas">Explorar rutas</a>
        </div>
      </div>
    </div>
    <a class="hero__scroll" href="#punto-de-partida" aria-label="Bajar a la siguiente sección">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" /><path d="M12 7v10m-4-4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </a>
  </section>

  <!-- EL PUNTO DE PARTIDA -->
  <section id="punto-de-partida" class="band band--light topo" aria-labelledby="partida-title">
    <p class="caption section-label" data-reveal>01</p>
    <h2 id="partida-title" class="heading partida__title" data-split>El punto de partida</h2>
    <div class="partida__grid">
      <p class="lead" data-reveal>Viajar hoy es más fácil que nunca <em>y reservar no es el problema.</em></p>
      <div class="partida__text" data-stagger>
        <p>El reto está en saber qué sí vale la pena, qué dejar fuera y cómo construir un viaje que realmente se sienta propio.</p>
        <p>LN41.5 nace desde esa idea: ayudar a viajeros a conocer España con más criterio, más contexto y menos itinerario típico.</p>
      </div>
    </div>
    <SectionCta />
  </section>

  <!-- CADA VIAJE SE DISEÑA COMO UNA RUTA NUEVA -->
  <section class="band band--dark topo" aria-labelledby="ruta-nueva-title">
    <p class="caption section-label" data-reveal>02</p>
    <div class="ruta-nueva__top">
      <div class="ruta-nueva__intro">
        <h2 id="ruta-nueva-title" class="heading ruta-nueva__title" data-split>Cada viaje se diseña como una nueva experiencia.</h2>
        <p class="ruta-nueva__strong" data-reveal>Trabajamos desde la intención de tu viaje, el ritmo, los intereses y el contexto.</p>
        <p class="ruta-nueva__text" data-reveal style="--d: 150">Diseñamos experiencias que combinan criterio, curaduría y conocimiento local para ayudarte a vivir una España más auténtica y mejor elegida.</p>
      </div>
      <div class="collage" aria-hidden="true">
        <div class="collage__item collage__item--1" data-toss data-parallax="0.06" style="--i: 0"><Photo name="collage-1" alt="" sizes="(min-width: 64rem) 22vw, 50vw" /></div>
        <div class="collage__item collage__item--2" data-toss data-parallax="0.14" style="--i: 1"><Photo name="collage-2" alt="" sizes="(min-width: 64rem) 20vw, 45vw" /></div>
        <div class="collage__item collage__item--3" data-toss data-parallax="0.1" style="--i: 2"><Photo name="collage-3" alt="" sizes="(min-width: 64rem) 18vw, 40vw" /></div>
        <span class="badge" data-spin>
          <svg viewBox="0 0 48 48" width="48" height="48"><circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M24 9l5 15-5 15-5-15z" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M24 9l5 15h-10z" fill="currentColor" /></svg>
        </span>
      </div>
    </div>
    <ul class="servicios" role="list" data-stagger>
      {servicios.map((s, i) => (
        <li class="servicio">
          <p class="caption servicio__num">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="subheading servicio__title">{s.title}</h3>
          <ul class="servicio__list">
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <SectionCta />
  </section>

  <!-- NO ES PARA TODOS -->
  <section class="band band--light topo" aria-labelledby="para-quien-title">
    <p class="caption section-label" data-reveal>03</p>
    <h2 id="para-quien-title" class="heading para-quien__title" data-split>
      Es para quienes quieren viajar mejor.
    </h2>
    <div class="para-quien__grid">
      <div class="para-quien__photo" data-toss>
        <Photo name="para-ti" alt="Faro de Cabo Vilán sobre las rocas de la Costa da Morte, Galicia" sizes="(min-width: 64rem) 35vw, 90vw" />
      </div>
      <div>
        <p class="lead para-quien__lead" data-reveal>LN41.5 está pensado para viajeros que valoran profundidad por encima de volumen.</p>
        <h3 class="caption para-ti__label" data-reveal>Para ti si…</h3>
        <ol class="para-ti" role="list" data-stagger>
          {paraTi.map((item, i) => (
            <li><span class="para-ti__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{item}</li>
          ))}
        </ol>
      </div>
    </div>
    <SectionCta />
  </section>

  <!-- BANNER EDICIÓN ESPECIAL -->
  {especial && (
    <section class="band band--base topo especial" aria-labelledby="especial-title">
      <div class="especial__grid">
        <div class="especial__copy">
          <p class="caption especial__tag" data-reveal>Edición especial / Viaje de temporada</p>
          <h2 id="especial-title" class="heading especial__title" data-split>{especial.data.title}</h2>
          <p class="lead especial__tagline" data-reveal><em>{especial.data.subtitle}</em></p>
          <p class="especial__text" data-reveal style="--d: 150">{especial.data.summary}</p>
          {especial.data.dates && <p class="caption especial__dates" data-reveal style="--d: 250">{especial.data.dates}</p>}
          <div class="btn-row" data-reveal style="--d: 350">
            <a class="btn btn--solid" href={`/rutas/${especial.id}`}>{especial.data.hero?.cta ?? 'Quiero saber más'}</a>
            <a class="btn btn--outline" href={designTripUrl(`Quiero diseñar mi viaje: ${especial.data.title}`)}>Diseñar mi viaje</a>
          </div>
        </div>
        <a class="especial__media" href={`/rutas/${especial.id}`} tabindex="-1" aria-hidden="true" data-toss style="--rot: 3deg">
          <Photo name={especial.data.photo} alt="" sizes="(min-width: 56rem) 40vw, 90vw" />
          <span class="especial__seal">
            <svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </div>
    </section>
  )}

  <!-- RUTAS -->
  <section id="rutas" class="band band--dark" aria-labelledby="rutas-title" data-trail>
    <svg class="trail" aria-hidden="true" focusable="false"><path class="trail__path" /><g class="trail__dots"></g></svg>
    <p class="caption section-label" data-reveal>04</p>
    <div class="rutas__intro" data-trail-start>
      <h2 id="rutas-title" class="heading rutas__title" data-split>Rutas de autor LN41.5</h2>
      <p class="rutas__lead" data-reveal>3 maneras de comenzar a conocer la otra España.</p>
    </div>
    <div class="rutas__grid" data-stagger>
      {rutas.map((ruta) => <RouteCard ruta={ruta} />)}
      <div class="rutas__end">
        <span class="rutas__pin" data-trail-end aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26"><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z M12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        </span>
        <p class="caption rutas__end-num">Tu ruta</p>
        <h3 class="subheading rutas__end-title">¿Y si la siguiente parada la diseñamos contigo?</h3>
        <a class="btn btn--outline btn--small" href={designTripUrl()}>Diseñar mi viaje</a>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" class="band band--light topo" aria-labelledby="proceso-title">
    <p class="caption section-label" data-reveal>05</p>
    <h2 id="proceso-title" class="heading proceso__title" data-split>Así se construye el viaje</h2>
    <ol class="proceso" role="list" data-scroll-line>
      {pasos.map((paso, i) => (
        <li class="paso" style={`--i: ${i}`}>
          <span class="paso__point" aria-hidden="true"></span>
          <p class="paso__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <p class="caption paso__label">Paso {i + 1}</p>
          <h3 class="subheading paso__title">{paso.title}</h3>
          <p class="paso__text">{paso.text}</p>
        </li>
      ))}
    </ol>
    <SectionCta />
  </section>

  <!-- POR QUÉ ESPAÑA -->
  <section class="band band--base topo" aria-labelledby="espana-title">
    <p class="caption section-label" data-reveal>06</p>
    <h2 id="espana-title" class="heading espana__title" data-split>Empezamos por España<br />por una razón</h2>
    <div class="espana__grid">
      <div class="espana__copy">
        <p class="lead espana__lead" data-reveal>Queremos construir profundidad donde realmente podemos aportar valor.</p>
        <p class="espana__text" data-reveal style="--d: 150">A España la conocemos desde dentro. Sus regiones, su mesa, sus pueblos y su ritmo. Por eso es el primer territorio de LN41.5: sabemos qué vale la pena, qué se queda fuera de los itinerarios y cómo se vive de verdad.</p>
      </div>
    </div>
    <SectionCta />
  </section>

  <!-- CAPACIDAD MUNDO: viajes de autor a otros destinos -->
  <section class="band band--dark mundo" aria-labelledby="mundo-title">
    <div class="mundo__inner" data-reveal>
      <span class="mundo__icon" aria-hidden="true" data-spin>
        <svg viewBox="0 0 24 24" width="30" height="30"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </span>
      <div class="mundo__copy">
        <p class="caption mundo__eyebrow">Capacidad · Mundo</p>
        <h2 id="mundo-title" class="subheading mundo__title">Viajes de autor a cualquier parte del mundo</h2>
        <p class="mundo__text">España es nuestra especialidad, pero no nuestro límite. Si tu próximo viaje es a otro destino, lo diseñamos con el mismo criterio, curaduría y atención al detalle.</p>
      </div>
      <a class="btn btn--outline" href={designTripUrl('Me interesa un viaje de autor a otro destino del mundo')}>Cotizar otro destino</a>
    </div>
  </section>

  <!-- MANIFIESTO -->
  <section class="band band--light topo manifiesto" aria-labelledby="manifiesto-title">
    <p class="caption section-label manifiesto__label" data-reveal>07 · Nuestro norte</p>
    <h2 id="manifiesto-title" class="heading manifiesto__title" data-split>Viajar con más sentido<br />y menos piloto automático</h2>
    <p class="manifiesto__intro" data-reveal>Cada viaje debería dejar una sensación muy simple:</p>
    <blockquote class="manifiesto__quote" data-split>
      <p>“Esto no lo habría armado así por mi cuenta.”</p>
    </blockquote>
    <p class="caption manifiesto__cierre" data-reveal style="--d: 400">Ese es el estándar.</p>
    <SectionCta align="center" />
  </section>

  <ClosingCta label="08" />
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: flex-end;
    padding: 8rem var(--gutter) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    background: var(--color-ink);
  }
  .hero__bg { position: absolute; inset: -10% 0 0; }
  .hero__bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(30 25 20 / 0.92) 0%, rgb(30 25 20 / 0.35) 50%, rgb(30 25 20 / 0.15) 100%);
  }
  .hero__content {
    position: relative; width: 100%;
    display: grid; gap: var(--space-5);
    align-items: end;
  }
  .hero__title { color: var(--color-gold); }
  .hero__title span { display: block; }
  .hero__aside { display: grid; gap: var(--space-4); max-width: 32rem; }
  .hero__text { font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.4375rem); line-height: 1.5; color: var(--color-sand); }
  .hero__scroll { position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0; color: var(--color-gold); display: none; }
  @media (min-width: 64rem) {
    .hero__content { grid-template-columns: 1fr auto; }
    .hero__scroll { display: block; }
  }

  /* PUNTO DE PARTIDA */
  .partida__title { color: var(--color-base); margin-bottom: var(--space-6); }
  .partida__grid { display: grid; gap: var(--space-5); }
  .partida__grid .lead { color: var(--color-base); max-width: 40rem; }
  .partida__grid .lead em { color: var(--color-copper); }
  .partida__text { display: grid; gap: var(--space-3); max-width: 36rem; font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.4375rem); line-height: 1.5; }
  @media (min-width: 56rem) {
    .partida__grid { grid-template-columns: 7fr 5fr; align-items: end; }
  }

  /* RUTA NUEVA */
  .ruta-nueva__top { display: grid; gap: var(--space-6); align-items: center; }
  .ruta-nueva__intro { display: grid; gap: var(--space-4); }
  .ruta-nueva__title { color: var(--color-gold); max-width: 14ch; }
  .ruta-nueva__strong { font-family: var(--font-display); font-weight: 600; font-size: var(--text-subheading); line-height: 1.1; max-width: 30rem; }
  .ruta-nueva__text { max-width: var(--max-text); color: var(--color-stone); font-size: 1.0625rem; }

  .collage { position: relative; height: clamp(22rem, 60vw, 36rem); }
  .collage__item { position: absolute; overflow: hidden; rotate: var(--rot); }
  .para-quien__photo { rotate: var(--rot); }
  .collage__item--1 { width: 52%; aspect-ratio: 4 / 5; left: 0; top: 6%; --rot: -8deg; }
  .collage__item--2 { width: 46%; aspect-ratio: 1; right: 2%; top: 0; --rot: 6deg; }
  .collage__item--3 { width: 42%; aspect-ratio: 3 / 4; left: 38%; bottom: 0; --rot: 3deg; }
  .badge { position: absolute; left: 4%; bottom: 6%; color: var(--color-gold); }
  @media (min-width: 64rem) {
    .ruta-nueva__top { grid-template-columns: 1fr 1fr; }
  }

  .servicios { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; gap: var(--space-5); }
  .servicio { border-top: 1px solid var(--hairline-dark); padding-top: var(--space-4); display: grid; gap: var(--space-3); align-content: start; }
  .servicio__num { color: var(--color-gold); }
  .servicio__title { color: var(--color-sand); }
  .servicio__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); color: var(--color-stone); }
  .servicio__list li { display: flex; gap: 0.75em; }
  .servicio__list li::before { content: ''; flex: 0 0 0.75rem; height: 1px; margin-top: 0.8em; background: var(--color-gold); }
  @media (min-width: 48rem) {
    .servicios { grid-template-columns: repeat(3, 1fr); }
  }

  /* PARA QUIÉN */
  .para-quien__title { color: var(--color-base); max-width: 20ch; margin-bottom: var(--space-6); }
  .para-quien__title em { color: var(--color-copper); }
  .para-quien__grid { display: grid; gap: var(--space-6); align-items: start; }
  .para-quien__photo { aspect-ratio: 4 / 5; overflow: hidden; --rot: -3deg; width: 100%; }
  .para-quien__lead { margin-bottom: var(--space-5); max-width: 36rem; }
  .para-ti__label { color: var(--color-copper); margin-bottom: var(--space-2); }
  .para-ti { list-style: none; margin: 0; padding: 0; }
  .para-ti li {
    display: grid; grid-template-columns: 3rem 1fr; align-items: baseline;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--hairline-light);
    font-size: 1.0625rem;
  }
  .para-ti li:last-child { border-bottom: 1px solid var(--hairline-light); }
  .para-ti__num { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: var(--color-copper); line-height: 1; }
  @media (min-width: 56rem) {
    .para-quien__grid { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  }

  /* CÓMO FUNCIONA — checkpoints de ruta */
  .proceso__title { color: var(--color-base); max-width: 14ch; margin-bottom: var(--space-6); }
  .proceso { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: var(--space-5); }
  /* Línea de ruta punteada que une los checkpoints */
  .proceso::before {
    content: ''; position: absolute;
    left: 0.5rem; top: 0.5rem; bottom: 0.5rem; width: 0;
    border-left: 1px dashed var(--color-copper);
    transform-origin: top;
  }
  .paso { position: relative; padding-left: var(--space-5); display: grid; gap: var(--space-2); align-content: start; }
  .paso__point {
    position: absolute; left: 0; top: 0.25rem;
    width: 1rem; height: 1rem; border-radius: 50%;
    background: var(--color-sand); border: 1px solid var(--color-copper);
  }
  .paso__point::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--color-copper); }
  .paso__num { font-family: var(--font-display); font-weight: 600; font-size: clamp(4rem, 3rem + 4vw, 7rem); line-height: 0.8; color: var(--color-copper); }
  .paso__label { color: var(--color-copper); margin-top: var(--space-2); }
  .paso__title { color: var(--color-base); }
  .paso__text { max-width: 22rem; }
  @media (min-width: 56rem) {
    .proceso { grid-template-columns: repeat(4, 1fr); gap: var(--space-4); padding-top: var(--space-5); }
    .proceso::before { left: 0.5rem; right: 0; top: 0.5rem; bottom: auto; width: auto; height: 0; border-left: 0; border-top: 1px dashed var(--color-copper); transform-origin: left; }
    .paso { padding-left: 0; padding-top: var(--space-5); }
    .paso__point { top: calc(-1 * var(--space-5)); }
    .paso:last-child .paso__point { background: var(--color-copper); }
  }
  /* Motion: la ruta se dibuja y los checkpoints aparecen uno tras otro */
  /* Motion: la línea punteada avanza con el scroll (--progress lo pone motion.ts)
     y cada paso aparece cuando la línea llega a su checkpoint */
  :global(html.motion) .proceso::before { scale: 1 var(--progress, 0); transition: scale 0.15s linear; }
  @media (min-width: 56rem) { :global(html.motion) .proceso::before { scale: var(--progress, 0) 1; } }
  :global(html.motion) .paso > :not(.paso__point) { opacity: 0; translate: 0 1.5rem; transition: opacity 0.7s ease, translate 0.9s var(--ease-out); }
  :global(html.motion) .paso__point { scale: 0; transition: scale 0.5s var(--ease-out); }
  :global(html.motion) .paso.is-reached > :not(.paso__point) { opacity: 1; translate: none; }
  :global(html.motion) .paso.is-reached .paso__point { scale: 1; }

  /* POR QUÉ ESPAÑA */
  .espana__title { color: var(--color-gold); margin-bottom: var(--space-6); }
  .espana__grid { display: grid; gap: var(--space-6); align-items: end; }
  .espana__copy { display: grid; gap: var(--space-4); }
  .espana__lead { color: var(--color-sand); max-width: 38rem; }
  .espana__lead em { color: var(--color-gold); }
  .espana__text { max-width: var(--max-text); color: var(--color-stone); font-size: 1.0625rem; }
  /* CAPACIDAD MUNDO */
