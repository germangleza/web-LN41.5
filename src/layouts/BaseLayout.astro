---
/** Layout base: HTML semántico + SEO + schemas globales. Todas las páginas lo usan. */
import SEO from '../components/SEO.astro';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import { SITE, designTripUrl, whatsappUrl, socialUrls } from '../config/site.config';
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Páginas de diseño full-bleed (home, rutas): el header flota sobre el hero y no hay contenedor. */
  fullBleed?: boolean;
}
const { fullBleed = false, ...props } = Astro.props;
// Rutas para el footer: las de autor en orden y al final las ediciones especiales
const footerRutas = (await getCollection('rutas', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.kind === b.data.kind ? a.data.order - b.data.order : a.data.kind === 'ruta' ? -1 : 1));
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <script is:inline>
      // Activa el motion solo con JS y sin "reducir movimiento". Si el script no carga, se muestra todo.
      (function (d) {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        setTimeout(function () { if (!d.classList.contains('is-loaded')) d.classList.remove('motion'); }, 3000);
      })(document.documentElement);
    </script>
    <SEO {...props} />
    <OrganizationSchema />
    <WebSiteSchema />
    {SITE.analytics.plausibleDomain && (
      <script defer data-domain={SITE.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <header class:list={['site-header', { 'site-header--overlay': fullBleed }]}>
      <nav aria-label="Principal">
        <a href="/" class="brand">
          <img src="/logo.webp" alt={SITE.name} width="480" height="254" />
        </a>
        <ul class="nav-links">
          <li class="nav-text"><a class="caption" href="/#rutas">Rutas</a></li>
          <li class="nav-text"><a class="caption" href="/blog">Blog</a></li>
          <li><a class="btn btn--outline btn--small" href={designTripUrl()}>Diseñar mi viaje</a></li>
        </ul>
      </nav>
    </header>

    <main class:list={{ page: !fullBleed }}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <a href="/" aria-label={`${SITE.name} — inicio`}>
          <img src="/logo.webp" alt="" width="480" height="254" loading="lazy" />
        </a>
        <div>
          <h2 class="caption">Explorar</h2>
          <ul>
            <li><a href="/#rutas">Rutas</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/#contacto">Contacto</a></li>
          </ul>
        </div>
        <div>
          <h2 class="caption">Rutas</h2>
          <ul>
            {footerRutas.map((r) => (
              <li><a href={`/rutas/${r.id}`}>{r.data.title}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="caption">Contacto</h2>
          <ul>
            <li><a href={`mailto:${SITE.business.email}`}>{SITE.business.email}</a></li>
            <li><a href={whatsappUrl()} rel="noopener">WhatsApp {SITE.business.phone}</a></li>
            {socialUrls().map((url) => <li><a href={url} rel="noopener me">{new URL(url).hostname.replace('www.', '').replace('.com', '')}</a></li>)}
          </ul>
        </div>
        <p class="caption footer-tagline">Viajes a España<br />diseñados con criterio<br />y conocimiento local</p>
      </div>
      <div class="footer-legal">
        <p>© {new Date().getFullYear()} {SITE.business.legalName || SITE.name}. Todos los derechos reservados.</p>
        <a class="btn btn--outline btn--small footer-credit" href={SITE.credit.url} target="_blank" rel="noopener">
          Construido por {SITE.credit.name} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
      import '../scripts/trail';
    </script>
  </body>
</html>
