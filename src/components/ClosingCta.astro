---
/** Cierre con llamado a la acción. Se usa en la home y en cada ruta. */
import Photo from './Photo.astro';
import { designTripUrl, whatsappUrl } from '../config/site.config';

interface Props {
  whatsappMessage?: string;
  /** Numeración de sección (ej. '08'). Se omite en las páginas de ruta. */
  label?: string;
  title?: string;
  text?: string;
  /** Texto del botón principal */
  cta?: string;
  /** Asunto del correo del botón principal */
  subject?: string;
}
const {
  whatsappMessage,
  label,
  title = '¿Estás pensando en ir o volver a España?',
  text = 'Cuéntanos qué tienes en mente y empecemos a diseñar una ruta a tu medida.',
  cta = 'Diseñar mi viaje',
  subject,
} = Astro.props;
---
<section class="closing" id="contacto" aria-labelledby="contacto-title">
  <div class="closing__bg" data-parallax="0.2">
    <Photo name="cierre" alt="" />
  </div>
  <div class="closing__content">
    {label && <p class="caption section-label closing__label" data-reveal>{label}</p>}
    <h2 id="contacto-title" class="heading" data-split>{title}</h2>
    {text && <p class="closing__text" data-reveal>{text}</p>}
    <div class="btn-row" data-reveal style="--d: 150">
      <a class="btn btn--solid" href={designTripUrl(subject)}>{cta}</a>
      <a class="btn btn--outline" href={whatsappUrl(whatsappMessage)} rel="noopener">Hablar por WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    min-height: 85svh;
    display: flex; align-items: flex-end;
    padding: var(--section-pad) var(--gutter);
    overflow: hidden;
    background: var(--color-ink);
  }
  .closing__bg { position: absolute; inset: -15% 0; }
  .closing__bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(30 25 20 / 0.95) 0%, rgb(30 25 20 / 0.55) 55%, rgb(30 25 20 / 0.3) 100%);
  }
  .closing__content { position: relative; display: grid; gap: var(--space-4); max-width: 60rem; }
  .closing h2 { color: var(--color-gold); }
  .closing__label { color: var(--color-gold); margin-bottom: 0; }
  .closing__text { font-size: 1.125rem; max-width: var(--max-text); color: var(--color-sand); }
</style>
